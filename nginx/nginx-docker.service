[Unit]
Description=nginx with ACME Module (Docker)
Documentation=https://github.com/nginx/nginx-acme
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
TimeoutStartSec=0
TimeoutStopSec=30
Restart=always
RestartSec=10s

# Environment variables
Environment="IMAGE=nginx-acme:latest"
Environment="CONTAINER_NAME=nginx-acme"

# Remove any existing container with the same name
ExecStartPre=-/usr/bin/docker rm -f ${CONTAINER_NAME}

# ACME state directory (account key + certificates). Must survive restarts.
ExecStartPre=/bin/mkdir -p /var/nginx-acme

# Start the nginx container. Health check comes from the image itself.
#
# Logs: the image symlinks /var/log/nginx/{access,error}.log to stdout/stderr,
# so they land in `docker logs` / `journalctl -u nginx-docker`, rotated by the
# json-file options below. Do NOT bind-mount a host directory over
# /var/log/nginx: it hides those symlinks, logs silently move to files that
# nothing rotates, and `docker logs` goes quiet.
ExecStart=/usr/bin/docker run --rm \
    --name ${CONTAINER_NAME} \
    --network host \
    --log-driver json-file \
    --log-opt max-size=10m \
    --log-opt max-file=3 \
    -v /etc/nginx:/etc/nginx:ro \
    -v /var/www:/var/www:ro \
    -v /var/nginx-acme:/var/nginx-acme \
    ${IMAGE}

# Stop the container gracefully
ExecStop=/usr/bin/docker stop -t 30 ${CONTAINER_NAME}

# Reload nginx configuration (test config first, then send HUP signal)
ExecReload=/bin/sh -c '/usr/bin/docker exec ${CONTAINER_NAME} nginx -t && /usr/bin/docker kill -s HUP ${CONTAINER_NAME}'

# Security settings. These constrain this unit's own processes (the docker
# client), not the container; ReadWritePaths is what lets ExecStartPre mkdir.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/nginx-acme

[Install]
WantedBy=multi-user.target
