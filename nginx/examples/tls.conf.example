# Drop-in example: HTTPS with an automatically issued Let's Encrypt certificate.
#
#   1. cp examples/tls.conf.example conf.d/example.com.conf
#   2. replace example.com with your domain (its A/AAAA records must already
#      point at this host, and port 80 must be reachable from the internet)
#   3. start with `acme_certificate letsencrypt_staging;` to validate the setup,
#      then switch to `letsencrypt` once you see a certificate being issued
#   4. mount conf.d into the container and reload: docker exec <c> nginx -s reload

server {
    listen 80;
    listen [::]:80;
    server_name example.com www.example.com;

    # The ACME module intercepts /.well-known/acme-challenge/ before this,
    # so redirecting everything else to HTTPS is safe.
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name example.com www.example.com;
    root /var/www/html;
    index index.html;

    acme_certificate letsencrypt_staging;
    ssl_certificate     $acme_certificate;
    ssl_certificate_key $acme_certificate_key;
    ssl_certificate_cache max=2;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1h;

    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        try_files $uri $uri/ =404;
    }
}
